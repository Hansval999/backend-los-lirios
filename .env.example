# ============================================================
#  Florería Los Lirios — Variables de entorno del backend
#  Copia este archivo a .env (local) o cárgalas en el panel de Render.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

NODE_ENV=development
PORT=8000

# --- MySQL (proveedor en la nube: Aiven, TiDB Cloud, Railway, etc.) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=floreria_los_lirios
DB_USER=root
DB_PASS=
# true si tu proveedor exige conexión TLS/SSL (Aiven, TiDB Cloud...)
DB_SSL=false

# --- JWT (genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- CORS: dominio(s) del frontend separados por coma ---
CORS_ORIGIN=http://localhost:5173

# --- Culqi (llave SECRETA, nunca en el frontend) ---
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Negocio ---
DELIVERY_COST=10
